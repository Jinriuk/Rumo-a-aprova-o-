# ============================================================
# Variáveis de ambiente — MODELO. Copie para .env e preencha.
#
# REGRA QUE NÃO SE NEGOCIA: a chave de serviço (service_role)
# NUNCA entra neste repositório nem no front. Ela só existe nas
# variáveis do Supabase (Edge Functions) e na sua máquina, para
# scripts de operador (seed de usuários).
# ============================================================

# --- Front (app/.env) — só chaves PÚBLICAS ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-publica-anon

# Coletor de erro do front (Etapa 4): a Edge Function registrar-erro do
# MESMO ambiente. Sem isso definido, o erro fica só no console. A CSP já
# cobre (*.supabase.co). Ver docs/operacao/alertas-dono.md.
# VITE_ERROR_REPORT_URL=https://SEU-PROJETO.supabase.co/functions/v1/registrar-erro

# Opcional: só no projeto Vercel de demo/vitrine (Production e Preview).
# NÃO definir no projeto de produção real — ausência = produção.
# Liga a faixa "AMBIENTE DE DEMONSTRAÇÃO" (app/src/shared/branding/ambiente.js).
# VITE_APP_ENV=demo

# --- Scripts de operador (scripts/*.mjs) — NUNCA no front ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=so-na-sua-maquina-e-no-servidor

# --- Testes locais (tests/) ---
PGHOST=127.0.0.1
PGPORT=54322
PGUSER=postgres
PGDATABASE=rumo_teste
